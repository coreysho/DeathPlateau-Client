/.gradle/
/.idea/

build/
*.class
*.*~

.DS_Store

# Runtime logs (dev-client.log, hs_err_pid*.log). NOTE: .gitignore has no effect on a file that is
# already tracked - dev-client.log was listed here (twice, plus *.log three times) and still showed
# up in every commit until it was actually untracked with: git rm --cached dev-client.log
*.log

# the launcher build output (the release workflow builds it)
launcher/out/

# What the release's build and launcher steps leave in the root when they are run locally, and what
# the python test runners leave beside themselves. client.jar is build/libs/rs2client-dev.jar under
# the name the release publishes it as, which is the copy you hand someone to test.
/client.jar
/Death-Plateau-Launcher.jar
__pycache__/

# The engine, checked out beside this one by build.yaml and release.yml so build.gradle can take
# the quest helper step table from it. A local checkout can live here too instead of ../Engine-TS.
/engine/
