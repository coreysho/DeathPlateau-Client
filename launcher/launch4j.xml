<!--
  Wraps Death-Plateau-Launcher.jar in a Windows .exe, so the thing a player downloads carries the
  Death Plateau badge in Explorer instead of the generic Java icon.

  WHY AN EXE AT ALL. The icon on a .jar file is the file-type icon Windows draws for .jar, owned
  by whichever Java runtime is registered. Nothing inside the archive can change it - setIconImages
  only reaches the WINDOW, not the file. An .exe is the only way to put our own icon on the thing
  sitting in somebody's Downloads folder.

  THE JAR IS STILL THE REAL ARTEFACT. This wraps it rather than replacing it: the .jar stays on
  every release for macOS, Linux and anyone who would rather run java -jar, and the .exe is the
  same bytes with a Windows face on. <dontWrapJar>false</dontWrapJar> embeds the jar inside the
  exe, so the download is one self-contained file.

  NO JRE IS BUNDLED. The exe finds an installed Java exactly as the jar does, and says so plainly
  if there is none - which is the same requirement players already have, not a new one.

  EVERY PATH BELOW IS RELATIVE TO THIS FILE, which is launch4j's rule and not an obvious one -
  it resolves against the config's own directory, not the working directory. That is why the jar
  and the exe, which the release step builds at the repository root, are reached with "..".
-->
<launch4jConfig>
  <headerType>gui</headerType>
  <jar>../Death-Plateau-Launcher.jar</jar>
  <dontWrapJar>false</dontWrapJar>
  <outfile>../Death-Plateau-Launcher.exe</outfile>
  <icon>launcher.ico</icon>
  <errTitle>Death Plateau Launcher</errTitle>
  <!-- A console window would flash up behind the launcher's own window on every start. -->
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <jre>
    <minVersion>1.8.0</minVersion>
    <!-- The launcher re-launches itself and the client as separate java processes (handOver,
         relaunchForUpdate), so it needs a real JRE on the machine, not a private one. -->
    <requiresJdk>false</requiresJdk>
    <requires64Bit>false</requires64Bit>
  </jre>
  <versionInfo>
    <!-- Shown on the file's Properties > Details tab, and in the UAC prompt if one ever appears. -->
    <fileVersion>1.0.0.0</fileVersion>
    <txtFileVersion>1.0.0.0</txtFileVersion>
    <fileDescription>Death Plateau Launcher</fileDescription>
    <copyright>Death Plateau</copyright>
    <productVersion>1.0.0.0</productVersion>
    <txtProductVersion>1.0.0.0</txtProductVersion>
    <productName>Death Plateau</productName>
    <internalName>Death-Plateau-Launcher</internalName>
    <originalFilename>Death-Plateau-Launcher.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
